# Auto detect text files and perform LF normalization
* text=auto

# gofmt rejects CRLF, so keep Go sources LF even on Windows checkouts.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Shell scripts run under bash on the Windows release runner, which chokes on CRLF.
*.sh text eol=lf

# Valve's openvr_api.dll is embedded as-is; never touch its bytes.
*.dll binary
